# Lokale, maschinenspezifische Einstellungen – .env NIE committen.
# Vorlage: .env.example (im Repo). Kopie als .env anlegen und Werte eintragen.

# --- Stick-Verankerung (Bestaetigung zur Ordner-Signatur, s. config.yaml) ---
# Seriennummer laut Windows USBSTOR (Geraete-Manager, Ereignis "konfiguriert")
STICK_SERIAL_USBSTOR=

# --- LLM: lokal (Ollama) ---
# Standard-Adresse eines lokal laufenden Ollama-Servers
OLLAMA_HOST=http://localhost:11434

# --- LLM: Claude-API (nur bei bewusst gewaehlter API-Variante, P8) ---
ANTHROPIC_API_KEY=
